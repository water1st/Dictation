<Application x:Class="Dictation.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Dictation.Presentation.ViewModels"
             xmlns:views="clr-namespace:Dictation.Presentation.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <views:HomePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LexiconLookupViewModel}">
            <views:LexiconLookupPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TextImportViewModel}">
            <views:TextImportPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ImportInboxListViewModel}">
            <views:ImportInboxListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ImportInboxDetailViewModel}">
            <views:ImportInboxDetailPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LearningPlanViewModel}">
            <views:LearningPlanPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PracticeSessionViewModel}">
            <views:PracticeSessionPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ReviewLibraryViewModel}">
            <views:ReviewLibraryPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ReviewPlanViewModel}">
            <views:ReviewPlanPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:WrongAnswerListViewModel}">
            <views:WrongAnswerListPage />
        </DataTemplate>
    </Application.Resources>
</Application>
