<Window x:Class="Dictation.Presentation.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding PageTitle}"
        Width="860"
        Height="620"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Closed="OnClosed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="22,16"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding GoBackCommand}"
                        Content="‹  返回"
                        IsEnabled="{Binding CanGoBack}"
                        Padding="10,6"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Grid.Column="1"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="{Binding PageTitle}" />
                <StackPanel Grid.Column="2"
                            Margin="12,0,0,0"
                            MaxWidth="260"
                            VerticalAlignment="Center"
                            DataContext="{Binding Update, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                    <Button x:Name="UpdateButton"
                            HorizontalAlignment="Right"
                            Padding="12,7"
                            Content="{Binding ButtonText}"
                            Command="{Binding InstallCommand}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White" />
                    <TextBlock x:Name="UpdateStatusText"
                               Margin="0,4,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ClipToBounds="True">
            <ContentControl x:Name="PreviousPagePresenter"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Opacity="0" />
            <ContentControl x:Name="CurrentPagePresenter"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{Binding CurrentPage}" />

            <Grid x:Name="OverlayLayer"
                  Panel.ZIndex="10"
                  Background="#99000000"
                  Visibility="{Binding IsOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="420"
                        MaxWidth="{Binding ActualWidth, ElementName=OverlayLayer}"
                        Padding="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentOverlay.Title}" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="{Binding CurrentOverlay.Message}"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,22,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Command="{Binding CancelOverlayCommand}"
                                    Content="取消"
                                    IsDefault="False"
                                    Visibility="{Binding IsOverlayConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="16,8" />
                            <Button Margin="10,0,0,0"
                                    Command="{Binding AcceptOverlayCommand}"
                                    Content="确定"
                                    Visibility="{Binding IsOverlayConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="16,8" />
                            <Button Margin="10,0,0,0"
                                    Command="{Binding DismissOverlayCommand}"
                                    Content="知道了"
                                    Padding="16,8">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverlayConfirmation}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOverlayBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
