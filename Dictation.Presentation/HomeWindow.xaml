<Window x:Class="Dictation.Presentation.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding PageTitle}"
        Width="860"
        Height="620"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Closed="OnClosed"
             FontSize="{DynamicResource BodyFontSize}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="TopBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" /><Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="3,0" /><Setter Property="FontSize" Value="{DynamicResource WindowIconFontSize}" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource WindowBackgroundBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="64" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource TopBarButtonStyle}" Command="{Binding GoBackCommand}" Content="‹"
                        ToolTip="返回" AutomationProperties.Name="返回" IsEnabled="{Binding CanGoBack}"
                        Visibility="{Binding IsBackButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="SemiBold"
                           Text="{Binding PageTitle}" TextTrimming="CharacterEllipsis" />
                <Grid Grid.Column="2" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                      DataContext="{Binding Update, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="UpdateErrorButton" Width="Auto" MaxWidth="142"
                            Margin="0" Padding="6,0" Click="OnUpdateErrorClick" IsEnabled="{Binding HasError}"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="打开本次更新错误日志" AutomationProperties.HelpText="{Binding StatusMessage}"
                            ToolTip="{Binding StatusMessage}" KeyboardNavigation.TabNavigation="None">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TopBarButtonStyle}">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanOpenErrorLog}" Value="True"><Setter Property="Cursor" Value="Hand" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    <TextBlock x:Name="UpdateStatusText" MaxWidth="130" Focusable="True" KeyboardNavigation.IsTabStop="False"
                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                               VerticalAlignment="Center" FontSize="{DynamicResource CaptionFontSize}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusMessage}" Foreground="{DynamicResource ErrorBrush}" Text="{Binding ErrorSummary}" />
                    </Button>
                    <Button x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource TopBarButtonStyle}" Width="Auto" Padding="10,0" FontSize="{DynamicResource BodyFontSize}"
                            Content="{Binding ButtonText}" Command="{Binding InstallCommand}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <Button x:Name="SettingsButton" Grid.Column="3" Style="{StaticResource TopBarButtonStyle}" Content="⚙" ToolTip="设置" AutomationProperties.Name="设置"
                        Command="{Binding OpenSettingsCommand}" Visibility="{Binding IsSettingsButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Grid.Column="4" Style="{StaticResource TopBarButtonStyle}" Content="−" ToolTip="最小化" AutomationProperties.Name="最小化" Click="OnMinimizeClick" />
                <Button Grid.Column="5" Style="{StaticResource TopBarButtonStyle}" Content="×" ToolTip="关闭" AutomationProperties.Name="关闭" Click="OnCloseClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ClipToBounds="True">
            <ContentControl x:Name="PreviousPagePresenter"
                            IsHitTestVisible="False"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Opacity="0" />
            <ContentControl x:Name="CurrentPagePresenter"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{Binding CurrentPage}" />

            <Grid x:Name="OverlayLayer"
                  Panel.ZIndex="10"
                  Background="#99000000"
                  Visibility="{Binding IsOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="420"
                        MaxWidth="{Binding ActualWidth, ElementName=OverlayLayer}"
                        Padding="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource SectionTitleFontSize}"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentOverlay.Title}" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="{Binding CurrentOverlay.Message}"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,22,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Command="{Binding CancelOverlayCommand}"
                                    Content="取消"
                                    IsDefault="False"
                                    Visibility="{Binding IsOverlayConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="16,8" />
                            <Button Margin="10,0,0,0"
                                    Command="{Binding AcceptOverlayCommand}"
                                    Content="确定"
                                    Visibility="{Binding IsOverlayConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="16,8" />
                            <Button Margin="10,0,0,0"
                                    Command="{Binding DismissOverlayCommand}"
                                    Content="知道了"
                                    Padding="16,8">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverlayConfirmation}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOverlayBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
