        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="ControlLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="FormHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="HeroTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
