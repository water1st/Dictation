<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!-- 字号与文字样式按信息职责集中定义，页面只保留布局及状态覆盖。 -->
    <system:Double x:Key="BodyFontSize">14</system:Double>
    <system:Double x:Key="IntroFontSize">15</system:Double>
    <system:Double x:Key="CaptionFontSize">12</system:Double>
    <system:Double x:Key="MetadataFontSize">11</system:Double>
    <system:Double x:Key="FinePrintFontSize">10</system:Double>
    <system:Double x:Key="BadgeFontSize">13</system:Double>
    <system:Double x:Key="HeroTitleFontSize">40</system:Double>
    <system:Double x:Key="PageTitleFontSize">28</system:Double>
    <system:Double x:Key="LanguageEntryTitleFontSize">65</system:Double>
    <system:Double x:Key="WorkspaceTitleFontSize">32</system:Double>
    <system:Double x:Key="NavigationTitleFontSize">28</system:Double>
    <system:Double x:Key="PanelTitleFontSize">24</system:Double>
    <system:Double x:Key="WindowTitleFontSize">20</system:Double>
    <system:Double x:Key="SectionTitleFontSize">20</system:Double>
    <system:Double x:Key="SubsectionTitleFontSize">16</system:Double>
    <system:Double x:Key="ListTitleFontSize">18</system:Double>
    <system:Double x:Key="GroupTitleFontSize">20</system:Double>
    <system:Double x:Key="GroupHeadwordFontSize">22</system:Double>
    <system:Double x:Key="DetailTitleFontSize">24</system:Double>
    <system:Double x:Key="CalendarTitleFontSize">22</system:Double>
    <system:Double x:Key="StatisticValueFontSize">28</system:Double>
    <system:Double x:Key="CheckInStatusFontSize">17</system:Double>
    <system:Double x:Key="SessionProgressFontSize">18</system:Double>
    <system:Double x:Key="QuestionPromptFontSize">24</system:Double>
    <system:Double x:Key="QuestionContentFontSize">30</system:Double>
    <system:Double x:Key="FeedbackFontSize">20</system:Double>
    <system:Double x:Key="CompletionTitleFontSize">28</system:Double>
    <system:Double x:Key="AnswerRevealFontSize">36</system:Double>
    <system:Double x:Key="IconFontSize">24</system:Double>
    <system:Double x:Key="PageIconFontSize">27</system:Double>
    <system:Double x:Key="ControlFontSize">16</system:Double>
    <system:Double x:Key="AnswerInputFontSize">28</system:Double>
    <system:Double x:Key="WindowIconFontSize">17</system:Double>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    </Style>
    <Style x:Key="StrongBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SecondaryBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
    </Style>
    <Style x:Key="IntroTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource IntroFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="MetadataTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource MetadataFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="FinePrintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
