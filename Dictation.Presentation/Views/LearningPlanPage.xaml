<UserControl x:Class="Dictation.Presentation.Views.LearningPlanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dictation.Presentation.Controls"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             FontSize="{DynamicResource BodyFontSize}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/Buttons.xaml" />
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/FormControls.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PlanButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Padding" Value="17,10" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="OptionCheckStyle" TargetType="CheckBox" BasedOn="{StaticResource FormCheckBoxStyle}">
            <Setter Property="Margin" Value="0,0,14,9" />
        </Style>
        <DataTemplate x:Key="OptionTemplate">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Style="{StaticResource OptionCheckStyle}" />
        </DataTemplate>
        <DataTemplate x:Key="LearningGroupTemplate">
            <Border Margin="0,0,0,10"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Margin="0,2,12,0"
                              VerticalAlignment="Top"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{DynamicResource ListTitleTextStyle}"
                                   Text="{Binding PrimaryMember.Headword}" TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,3,0,0"
                                   Text="{Binding PrimaryMember.Reading}" TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,5,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding PrimaryMember.PartOfSpeechLabel}" />
                        <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding PrimaryMember.Meanings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}"
                                               Text="{Binding Path=., Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="{DynamicResource SectionBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="54" Height="54"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="27">
                <TextBlock Style="{DynamicResource PageIconTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Text="◎" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Style="{DynamicResource HeaderTextGroupStyle}">
                <TextBlock Style="{DynamicResource PageTitleTextStyle}" Text="{Binding WindowTitle}" TextWrapping="Wrap" />
                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,4,0,0"
                           Text="设定每日学习节奏" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="2" Padding="12,8" MinHeight="40" VerticalAlignment="Center"
                    Background="{DynamicResource AccentSoftBrush}" CornerRadius="15">
                <TextBlock Style="{DynamicResource StrongBodyTextStyle}" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding LanguageLabel}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.42*" MinWidth="290" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer controls:PageScrollHost.IsPageScrollViewer="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Padding="18" Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="今天的节奏" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource BodyTextStyle}" Text="每日新词" />
                                    <TextBox Margin="0,6,0,0" Padding="10,7"
                                             Text="{Binding DailyNewTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{DynamicResource BodyTextStyle}" Text="每轮词数" />
                                    <TextBox Margin="0,6,0,0" Padding="10,7"
                                             Text="{Binding SessionWordLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{DynamicResource FormHeadingTextStyle}" Margin="0,18,0,8" Text="抽取方式" />
                            <StackPanel>
                                <RadioButton Content="随机" IsChecked="{Binding IsRandomSelection, Mode=TwoWay}" />
                                <RadioButton Margin="0,7,0,0" Content="按加入顺序" IsChecked="{Binding IsSequentialSelection, Mode=TwoWay}" />
                                <RadioButton Margin="0,7,0,0" Content="手动选择" IsChecked="{Binding IsManualSelection, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="18"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="练习内容" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,13,0,7" Text="词形" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding FormOptions}" ItemTemplate="{StaticResource OptionTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,9,0,7" Text="出题方式" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding ChannelOptions}" ItemTemplate="{StaticResource OptionTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,9,0,7" Text="书写形式" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding OutputOptions}" ItemTemplate="{StaticResource OptionTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="18"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18"
                            Visibility="{Binding IsEnglish, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="英语词形提示" />
                            <RadioButton Margin="0,12,0,0" Content="显示语法名称"
                                         IsChecked="{Binding IsGrammarName, Mode=TwoWay}" />
                            <RadioButton Margin="0,7,0,0" Content="使用示例词形"
                                         IsChecked="{Binding IsExampleParadigm, Mode=TwoWay}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Padding="10,7" Text="{Binding ExampleQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding SearchExamplesCommand}"
                                        Content="查找" Style="{StaticResource PlanButtonStyle}" Tag="{StaticResource SearchIconGeometry}"
                                        ContentTemplate="{StaticResource IconTextButtonContentTemplate}" />
                            </Grid>
                            <ListBox Margin="0,9,0,0" MaxHeight="130"
                                     ItemsSource="{Binding ExampleCandidates}"
                                     SelectedItem="{Binding SelectedExample, Mode=TwoWay}"
                                     DisplayMemberPath="Headword" ItemContainerStyle="{DynamicResource ContentListItemStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Padding="18"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <CheckBox Content="全选" IsThreeState="True"
                                  IsEnabled="{Binding CanSelectAll, FallbackValue=False}"
                                  IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                                  FontSize="{DynamicResource ControlFontSize}" FontWeight="SemiBold" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Grid.Column="1" TextWrapping="Wrap" >
                            <Run Text="共 " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" 组" />
                        </TextBlock>
                    </Grid>
                    <ListBox Grid.Row="1" Margin="0,14,0,0"
                             Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding LibraryItems}"
                             ItemTemplate="{StaticResource LearningGroupTemplate}"
                             HorizontalContentAlignment="Stretch" ItemContainerStyle="{DynamicResource ContentListItemStyle}" />
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" >
                            <Run Text="第 " /><Run Text="{Binding PageNumber, Mode=OneWay}" /><Run Text=" 页" />
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding PreviousPageCommand}" Content="上一页" Style="{StaticResource PlanButtonStyle}" />
                            <Button Command="{Binding NextPageCommand}" Content="下一页" Style="{StaticResource PlanButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource BodyTextStyle}" Foreground="{DynamicResource ErrorBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                <TextBlock Style="{DynamicResource BodyTextStyle}" Foreground="{DynamicResource AccentBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding DeleteSelectedCommand}" Content="移除所选" Style="{StaticResource DestructiveActionButtonStyle}" Margin="8,0,0,0" />
                <Button Command="{Binding SaveCommand}" Content="保存计划" Style="{StaticResource PlanButtonStyle}"
                        Tag="{StaticResource SaveIconGeometry}" ContentTemplate="{StaticResource IconTextButtonContentTemplate}" />
                <Button Command="{Binding StartCommand}" Content="开始本轮" Style="{StaticResource PlanButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
