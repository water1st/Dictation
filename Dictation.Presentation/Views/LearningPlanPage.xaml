<UserControl x:Class="Dictation.Presentation.Views.LearningPlanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/FormControls.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PlanButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="17,10" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionCheckStyle" TargetType="CheckBox" BasedOn="{StaticResource FormCheckBoxStyle}">
            <Setter Property="Margin" Value="0,0,14,9" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <DataTemplate x:Key="OptionTemplate">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Style="{StaticResource OptionCheckStyle}" />
        </DataTemplate>
        <DataTemplate x:Key="LearningGroupTemplate">
            <Border Margin="0,0,0,10"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Margin="0,2,12,0"
                              VerticalAlignment="Top"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding PrimaryMember.Headword}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="{Binding PrimaryMember.Reading}" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding PrimaryMember.PartOfSpeechLabel}" />
                        <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding PrimaryMember.Meanings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               Text="{Binding Path=., Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="54" Height="54"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="27">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="25" Foreground="{DynamicResource AccentBrush}" Text="◎" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding WindowTitle}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="选好本轮范围与练习方式，再开始今天的学习。" />
            </StackPanel>
            <Border Grid.Column="2" Padding="12,8"
                    Background="{DynamicResource AccentSoftBrush}" CornerRadius="15">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding LanguageLabel}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Padding="18" Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="今天的节奏" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="每日新词" />
                                    <TextBox Margin="0,6,0,0" Padding="10,7"
                                             Text="{Binding DailyNewTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="每轮词数" />
                                    <TextBox Margin="0,6,0,0" Padding="10,7"
                                             Text="{Binding SessionWordLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="0,18,0,8" FontWeight="SemiBold" Text="抽取方式" />
                            <StackPanel>
                                <RadioButton Content="随机" IsChecked="{Binding IsRandomSelection, Mode=TwoWay}" />
                                <RadioButton Margin="0,7,0,0" Content="按加入顺序" IsChecked="{Binding IsSequentialSelection, Mode=TwoWay}" />
                                <RadioButton Margin="0,7,0,0" Content="手动选择" IsChecked="{Binding IsManualSelection, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="18"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="练习内容" />
                            <TextBlock Margin="0,13,0,7" Foreground="{DynamicResource SecondaryForegroundBrush}" Text="词形" />
                            <ItemsControl ItemsSource="{Binding FormOptions}" ItemTemplate="{StaticResource OptionTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Margin="0,9,0,7" Foreground="{DynamicResource SecondaryForegroundBrush}" Text="出题方式" />
                            <ItemsControl ItemsSource="{Binding ChannelOptions}" ItemTemplate="{StaticResource OptionTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Margin="0,9,0,7" Foreground="{DynamicResource SecondaryForegroundBrush}" Text="书写形式" />
                            <ItemsControl ItemsSource="{Binding OutputOptions}" ItemTemplate="{StaticResource OptionTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="18"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18"
                            Visibility="{Binding IsEnglish, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="英语词形提示" />
                            <RadioButton Margin="0,12,0,0" Content="显示语法名称"
                                         IsChecked="{Binding IsGrammarName, Mode=TwoWay}" />
                            <RadioButton Margin="0,7,0,0" Content="使用示例词形"
                                         IsChecked="{Binding IsExampleParadigm, Mode=TwoWay}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Padding="10,7" Text="{Binding ExampleQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding SearchExamplesCommand}"
                                        Content="查找" Style="{StaticResource PlanButtonStyle}" />
                            </Grid>
                            <ListBox Margin="0,9,0,0" MaxHeight="130"
                                     ItemsSource="{Binding ExampleCandidates}"
                                     SelectedItem="{Binding SelectedExample, Mode=TwoWay}"
                                     DisplayMemberPath="Headword" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Padding="18"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <CheckBox Content="全选" IsThreeState="True"
                                  IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                                  FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="共 " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" 组" />
                        </TextBlock>
                    </Grid>
                    <ListBox Grid.Row="1" Margin="0,14,0,0"
                             Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding LibraryItems}"
                             ItemTemplate="{StaticResource LearningGroupTemplate}"
                             HorizontalContentAlignment="Stretch" />
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="第 " /><Run Text="{Binding PageNumber, Mode=OneWay}" /><Run Text=" 页" />
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding PreviousPageCommand}" Content="上一页" Style="{StaticResource PlanButtonStyle}" />
                            <Button Command="{Binding NextPageCommand}" Content="下一页" Style="{StaticResource PlanButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource ErrorBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                <TextBlock Foreground="{DynamicResource AccentBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding DeleteSelectedCommand}" Content="移除所选" Style="{StaticResource PlanButtonStyle}" />
                <Button Command="{Binding SaveCommand}" Content="保存计划" Style="{StaticResource PlanButtonStyle}" />
                <Button Command="{Binding StartCommand}" Content="开始本轮" Style="{StaticResource PlanButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
