<UserControl x:Class="Dictation.Presentation.Views.ImportInboxListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Dictation.Presentation.Behaviors"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <Style x:Key="InboxButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InboxListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="BatchTemplate">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="批次" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="{Binding Items.Count, StringFormat=项目 {0} 个}" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="{Binding CreatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="InboxItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox VerticalAlignment="Top"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          IsEnabled="{Binding IsSelectable}" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{Binding SourceText}" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="{Binding DecisionLabel}" />
                    </Grid>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding PrimaryMember.Headword}" />
                    <ItemsControl Margin="0,4,0,0"
                                  ItemsSource="{Binding PrimaryMember.Meanings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,1"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextWrapping="Wrap">
                                    <Run Text="•  " />
                                    <Run Text="{Binding Path=., Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="暂无中文释义"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrimaryMember.Meanings.Count}"
                                                 Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WordGroup}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl Margin="0,6,0,0"
                                  ItemsSource="{Binding PrimaryMember.Forms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}">
                                    <Run Text="{Binding FormLabel, Mode=OneWay}" />
                                    <Run Text="：" />
                                    <Run Text="{Binding Surface, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="54"
                    Height="54"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="27">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="25"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="▣" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="{Binding WindowTitle}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="确认词组后，送入学习、复习，或直接丢弃。" />
            </StackPanel>
            <Border Grid.Column="2"
                    Padding="12,8"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="15">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding LanguageLabel}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Padding="14,10"
                     Background="{DynamicResource CardBackgroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     FontSize="16"
                     Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="筛选当前批次项目" />
            <Button Grid.Column="1"
                    Margin="12,0,0,0"
                    Command="{Binding RefreshCommand}"
                    Content="刷新"
                    Style="{StaticResource InboxButtonStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="2"
                      behaviors:ScrollViewerOffsetBehavior.VerticalOffset="{Binding ScrollOffset, Mode=TwoWay}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="16"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="待确认批次" />
                        <ListBox Margin="0,12,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource InboxListItemStyle}"
                                 ItemTemplate="{StaticResource BatchTemplate}"
                                 ItemsSource="{Binding Batches}"
                                 SelectedItem="{Binding SelectedBatch, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="18"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <CheckBox Content="全选"
                                  IsThreeState="False"
                                  IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                                  FontSize="16"
                                  FontWeight="SemiBold" />
                        <ListBox Grid.Row="1"
                                 Margin="0,12,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource InboxListItemStyle}"
                                 ItemTemplate="{StaticResource InboxItemTemplate}"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="{Binding EmptyStateText}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource ErrorBrush}"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding SendToLearningCommand}"
                        Content="送入学习"
                        IsEnabled="{Binding CanDecide}"
                        Style="{StaticResource InboxButtonStyle}" />
                <Button Command="{Binding SendToReviewCommand}"
                        Content="送入复习"
                        IsEnabled="{Binding CanDecide}"
                        Style="{StaticResource InboxButtonStyle}" />
                <Button Command="{Binding DiscardCommand}"
                        Content="丢弃"
                        IsEnabled="{Binding CanDecide}"
                        Style="{StaticResource InboxButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
