<UserControl x:Class="Dictation.Presentation.Views.ImportInboxDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dictation.Presentation.Controls"
             xmlns:behaviors="clr-namespace:Dictation.Presentation.Behaviors"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             FontSize="{DynamicResource BodyFontSize}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/Buttons.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="DetailSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}" />

        <Style x:Key="DetailBadgeStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>

        <DataTemplate x:Key="FormTemplate">
            <Border Margin="0,0,8,8"
                    Padding="10,7"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">
                <StackPanel>
                    <TextBlock Style="{DynamicResource StrongBodyTextStyle}">
                        <Run Text="{Binding FormLabel, Mode=OneWay}" />
                        <Run Text="：" />
                        <Run Text="{Binding Surface, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{DynamicResource CaptionTextStyle}" Margin="0,2,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="{Binding DetailLabel}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MemberTemplate">
            <Border Margin="0,0,0,14"
                    Padding="{DynamicResource ContentCardPadding}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource GroupHeadwordTextStyle}"
                                       Text="{Binding Headword}" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,4,0,0"
                                       Text="{Binding Reading}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Grid.Column="1"
                                   Margin="12,5,0,0"
                                   Text="{Binding SourceSenseId}" TextWrapping="Wrap" />
                    </Grid>

                    <WrapPanel Margin="0,12,0,4">
                        <Border Style="{StaticResource DetailBadgeStyle}">
                            <TextBlock Style="{DynamicResource BodyTextStyle}" Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding PartOfSpeechLabel}" />
                        </Border>
                        <Border Style="{StaticResource DetailBadgeStyle}">
                            <TextBlock Style="{DynamicResource BodyTextStyle}" Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding AttributeLabel}" />
                        </Border>
                        <Border>
                            <TextBlock Style="{DynamicResource BodyTextStyle}" Foreground="{DynamicResource AccentBrush}"
                                       Text="短语" />
                            <Border.Style>
                                <Style BasedOn="{StaticResource DetailBadgeStyle}"
                                       TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPhrase}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </WrapPanel>

                    <TextBlock Style="{DynamicResource SubsectionTitleTextStyle}" Margin="0,4,0,8"
                               Text="词形" />
                    <ItemsControl ItemTemplate="{StaticResource FormTemplate}"
                                  ItemsSource="{Binding Forms}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Style="{DynamicResource FormHeadingTextStyle}" Margin="0,10,0,8"
                               Text="中文释义（每行一条）" />
                    <TextBox MinHeight="78"
                             Padding="12,9"
                             AcceptsReturn="True"
                             Background="{DynamicResource WindowBackgroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Text="{Binding ChineseMeaningDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Command="{Binding SaveCommand}"
                                Content="保存中文释义"
                                Style="{StaticResource DetailSaveButtonStyle}" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding SaveStatusMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="{DynamicResource SectionBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="54"
                    Height="54"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="27">
                <TextBlock Style="{DynamicResource PageIconTextStyle}" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="◎" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Style="{DynamicResource PageTitleTextStyle}"
                           Text="{Binding SourceText}" TextWrapping="Wrap" />
                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" >
                    <Run Text="{Binding DecisionLabel, Mode=OneWay}" />
                    <Run Text=" · 整组词条详情" />
                </TextBlock>
            </StackPanel>
            <Border Grid.Column="2"
                    VerticalAlignment="Center"
                    MinHeight="40"
                    Padding="12,8"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="15">
                <TextBlock Style="{DynamicResource StrongBodyTextStyle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding LanguageLabel}" />
            </Border>
        </Grid>

        <ScrollViewer controls:PageScrollHost.IsPageScrollViewer="True" Grid.Row="1"
                      behaviors:ScrollViewerOffsetBehavior.VerticalOffset="{Binding ScrollOffset, Mode=TwoWay}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemTemplate="{StaticResource MemberTemplate}"
                          ItemsSource="{Binding Members}" />
        </ScrollViewer>
    </Grid>
</UserControl>
