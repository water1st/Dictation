<UserControl x:Class="Dictation.Presentation.Views.ImportInboxDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Dictation.Presentation.Behaviors"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <Style x:Key="DetailBadgeStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>

        <DataTemplate x:Key="FormTemplate">
            <Border Margin="0,0,8,8"
                    Padding="10,7"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="{Binding FormLabel, Mode=OneWay}" />
                        <Run Text="：" />
                        <Run Text="{Binding Surface, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="{Binding DetailLabel}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MemberTemplate">
            <Border Margin="0,0,0,14"
                    Padding="20"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="{Binding Headword}" />
                            <TextBlock Margin="10,5,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="{Binding Reading}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="12,5,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="{Binding SourceSenseId}" />
                    </Grid>

                    <WrapPanel Margin="0,12,0,4">
                        <Border Style="{StaticResource DetailBadgeStyle}">
                            <TextBlock Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding PartOfSpeechLabel}" />
                        </Border>
                        <Border Style="{StaticResource DetailBadgeStyle}">
                            <TextBlock Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding AttributeLabel}" />
                        </Border>
                        <Border>
                            <TextBlock Foreground="{DynamicResource AccentBrush}"
                                       Text="短语" />
                            <Border.Style>
                                <Style BasedOn="{StaticResource DetailBadgeStyle}"
                                       TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPhrase}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </WrapPanel>

                    <TextBlock Margin="0,4,0,8"
                               FontWeight="SemiBold"
                               Text="词形" />
                    <ItemsControl ItemTemplate="{StaticResource FormTemplate}"
                                  ItemsSource="{Binding Forms}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Margin="0,10,0,8"
                               FontWeight="SemiBold"
                               Text="中文释义（每行一条）" />
                    <TextBox MinHeight="78"
                             Padding="12,9"
                             AcceptsReturn="True"
                             Background="{DynamicResource WindowBackgroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Text="{Binding ChineseMeaningDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="54"
                    Height="54"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="27">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="25"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="◎" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="{Binding SourceText}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <Run Text="{Binding DecisionLabel, Mode=OneWay}" />
                    <Run Text=" · 整组词条详情" />
                </TextBlock>
            </StackPanel>
            <Border Grid.Column="2"
                    Padding="12,8"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="15">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding LanguageLabel}" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      behaviors:ScrollViewerOffsetBehavior.VerticalOffset="{Binding ScrollOffset, Mode=TwoWay}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemTemplate="{StaticResource MemberTemplate}"
                          ItemsSource="{Binding Members}" />
        </ScrollViewer>
    </Grid>
</UserControl>
