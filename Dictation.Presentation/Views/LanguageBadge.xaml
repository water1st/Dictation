<UserControl x:Class="Dictation.Presentation.Views.LanguageBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:configuration="clr-namespace:Dictation.Core.Configuration;assembly=Dictation.Core"
             Width="32" Height="32" IsHitTestVisible="False">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers><DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Style>
    <Viewbox Stretch="Uniform">
        <Grid Width="32" Height="32">
            <Grid.Clip><EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" /></Grid.Clip>
            <Grid>
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SourceLanguage, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static configuration:LearningLanguage.Japanese}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Ellipse Fill="White" /><Ellipse Width="15" Height="15" Fill="#BC002D" />
            </Grid>
            <Grid>
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SourceLanguage, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static configuration:LearningLanguage.English}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Rectangle Fill="#012169" />
                <Path Data="M0,0 L32,32 M0,32 L32,0" Stroke="White" StrokeThickness="7" />
                <Path Data="M0,0 L32,32 M0,32 L32,0" Stroke="#C8102E" StrokeThickness="2.5" />
                <Rectangle Width="9" Fill="White" /><Rectangle Height="9" Fill="White" />
                <Rectangle Width="4.5" Fill="#C8102E" /><Rectangle Height="4.5" Fill="#C8102E" />
            </Grid>
            <Ellipse Stroke="#8A99AD" StrokeThickness="0.7" />
        </Grid>
    </Viewbox>
</UserControl>
