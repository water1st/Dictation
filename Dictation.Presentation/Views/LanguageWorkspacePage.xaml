<UserControl x:Class="Dictation.Presentation.Views.LanguageWorkspacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Dictation.Presentation.Views"
             Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
             FontSize="{DynamicResource BodyFontSize}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/Buttons.xaml" />
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/NavigationCards.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationCardButtonStyle}" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource PageContentMargin}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <Grid Margin="{DynamicResource SectionBottomMargin}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <views:LanguageBadge SourceLanguage="{Binding SelectedLanguage}" IsActive="True" Width="64" Height="64" />
            <StackPanel Grid.Column="2" Style="{DynamicResource HeaderTextGroupStyle}">
                <TextBlock Style="{DynamicResource WorkspaceTitleTextStyle}" Text="{Binding CurrentLanguageLabel}" />
                <TextBlock Style="{DynamicResource BadgeTextStyle}" Text="学习与复习" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border x:Name="CheckInCard" Margin="0,0,0,0" Padding="20,16" CornerRadius="18"
                        Background="{DynamicResource AccentSoftBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowCheckInCelebration}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="CheckInCelebration">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:0.6" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="CheckInCelebration" /></DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource CheckInStatusTextStyle}" x:Name="TodayCheckInStatus" Text="{Binding CheckInStatusLabel}"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Style="{DynamicResource BodyTextStyle}" Text="{Binding ActualTasksLabel}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource CaptionTextStyle}" Text="当天任务在首次练习时确定，日语与英语分别打卡。" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" />
                        <TextBlock Style="{DynamicResource BodyTextStyle}" Text="{Binding CheckInErrorMessage}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <Button  Grid.Row="0" Grid.Column="0" Margin="0,0,12,12"
                            Style="{StaticResource CardButtonStyle}"
                            Command="{Binding OpenLearningCommand}">
                        <StackPanel Style="{DynamicResource NavigationTextGroupStyle}">
                            <TextBlock Style="{DynamicResource NavigationTitleTextStyle}" Text="开始学习" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="继续学习开启新轮" TextWrapping="Wrap" Margin="{DynamicResource DescriptionTopMargin}" />
                            <TextBlock Style="{DynamicResource StrongBodyTextStyle}" x:Name="LearningProgressText" Text="{Binding LearningProgressLabel}" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StartReviewButton" Grid.Row="0" Grid.Column="1" Margin="0,0,12,12"
                            Style="{StaticResource CardButtonStyle}"
                            Command="{Binding OpenReviewSessionCommand}">
                        <StackPanel Style="{DynamicResource NavigationTextGroupStyle}">
                            <TextBlock Style="{DynamicResource NavigationTitleTextStyle}" Text="开始复习" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="复习待测到期词组" TextWrapping="Wrap" Margin="{DynamicResource DescriptionTopMargin}" />
                            <TextBlock Style="{DynamicResource StrongBodyTextStyle}" x:Name="ReviewDailyProgress" Text="{Binding ReviewProgressLabel}" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Button>
                    <Button  Grid.Row="1" Grid.Column="0" Margin="0,0,12,12"
                            Style="{StaticResource CardButtonStyle}"
                            Command="{Binding OpenReviewLibraryCommand}">
                        <StackPanel Style="{DynamicResource NavigationTextGroupStyle}">
                            <TextBlock Style="{DynamicResource NavigationTitleTextStyle}" Text="复习词库" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="查看已学词组进度" TextWrapping="Wrap" Margin="{DynamicResource DescriptionTopMargin}" />

                        </StackPanel>
                    </Button>
                    <Button x:Name="KanaButton" Grid.Row="1" Grid.Column="1" Margin="0,0,12,12"
                            Style="{StaticResource CardButtonStyle}" Visibility="{Binding IsJapaneseSelected, Converter={StaticResource BoolVisibility}}"
                            Command="{Binding OpenKanaCommand}">
                        <StackPanel Style="{DynamicResource NavigationTextGroupStyle}">
                            <TextBlock Style="{DynamicResource NavigationTitleTextStyle}" Text="五十音听写" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="独立练习假名听写发音" TextWrapping="Wrap" Margin="{DynamicResource DescriptionTopMargin}" />
                            <TextBlock Style="{DynamicResource StrongBodyTextStyle}" x:Name="KanaProgressText" Text="{Binding KanaProgressLabel}" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Button>
                    <Button  Grid.Row="2" Grid.Column="0" Margin="0,0,12,12"
                            Style="{StaticResource CardButtonStyle}"
                            Command="{Binding DataContext.OpenStatisticsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Style="{DynamicResource NavigationTextGroupStyle}">
                            <TextBlock Style="{DynamicResource NavigationTitleTextStyle}" Text="学习足迹" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="查看打卡记忆趋势" TextWrapping="Wrap" Margin="{DynamicResource DescriptionTopMargin}" />

                        </StackPanel>
                    </Button>
                    <Button  Grid.Row="2" Grid.Column="1" Margin="0,0,12,12"
                            Style="{StaticResource CardButtonStyle}"
                            Command="{Binding OpenWrongAnswersCommand}">
                        <StackPanel Style="{DynamicResource NavigationTextGroupStyle}">
                            <TextBlock Style="{DynamicResource NavigationTitleTextStyle}" Text="错题回顾" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="错题词形针对重练" TextWrapping="Wrap" Margin="{DynamicResource DescriptionTopMargin}" />

                        </StackPanel>
                    </Button>
                    <Button  Grid.Row="3" Grid.Column="0" Margin="0,0,12,12"
                            Style="{StaticResource CardButtonStyle}"
                            Command="{Binding OpenLexiconLookupCommand}">
                        <StackPanel Style="{DynamicResource NavigationTextGroupStyle}">
                            <TextBlock Style="{DynamicResource NavigationTitleTextStyle}" Text="本地查词" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="浏览本地词义词形" TextWrapping="Wrap" Margin="{DynamicResource DescriptionTopMargin}" />

                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Style="{DynamicResource BodyTextStyle}" x:Name="ReviewProgressError" Text="{Binding ReviewProgressErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                <TextBlock Style="{DynamicResource BodyTextStyle}" Text="{Binding KanaProgressErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                <TextBlock Style="{DynamicResource BodyTextStyle}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
