<UserControl x:Class="Dictation.Presentation.Views.KanaSessionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="Margin" Value="0,8,12,0" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style x:Key="FeedbackVisibility" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFeedbackVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SummaryVisibility" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="42,28" MaxWidth="880">
            <TextBlock Text="五十音听写" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Margin="0,10,0,20" Text="{Binding ProgressLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="18" />
            <Border CornerRadius="24" Padding="28" Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel>
                    <TextBlock x:Name="QuestionPrompt" Text="{Binding QuestionPrompt}" FontSize="24" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,10,0,14">
                        <Button Content="🔊" ToolTip="播放当前发音" AutomationProperties.Name="播放当前发音" Command="{Binding PlayCommand}" FontSize="24" />
                        <Button Content="取消操作" Command="{Binding CancelCommand}" />
                    </WrapPanel>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsAnswering}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="写出听到的假名（当前使用键盘输入；手写／OCR在后续输入切片接入）" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" />
                        <TextBox Margin="0,14,0,8" Padding="16" FontSize="28" SpellCheck.IsEnabled="False"
                                 Foreground="{DynamicResource ForegroundBrush}" Background="{DynamicResource WindowBackgroundBrush}"
                                 Text="{Binding AnswerText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="检查答案" Command="{Binding SubmitCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel x:Name="FeedbackPanel" Style="{StaticResource FeedbackVisibility}">
                        <TextBlock Text="{Binding FeedbackLabel}" Margin="0,14,0,8" FontSize="20" TextWrapping="Wrap" />
                        <TextBlock Text="正确写法" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                        <TextBlock x:Name="CorrectAnswer" Text="{Binding CorrectAnswerDisplay}" FontSize="36" Margin="0,8" />
                        <Button Content="继续" Command="{Binding ContinueCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel x:Name="SummaryPanel" Style="{StaticResource SummaryVisibility}">
                        <TextBlock Text="本轮完成！" FontSize="26" Margin="0,14,0,10" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="本轮错项（已正确重练的错误也保留在此）" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Errors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14" Margin="0,10,0,0" CornerRadius="14" Background="{DynamicResource WindowBackgroundBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SubmittedText}" Margin="0,0,16,0" Foreground="{DynamicResource ErrorBrush}" />
                                            <TextBlock Text="→" Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding CorrectAnswer}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,16,0,0" Text="使用上方返回按钮回到计划或首页。" />
                    </StackPanel>
                    <TextBlock Text="今天没有新的待练项目，或计划未启用。可以返回调整范围。" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,14,0,0" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
                    <Button Content="重试读取已提交结果" Command="{Binding RecoverSubmissionCommand}" HorizontalAlignment="Left">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasPendingFeedback}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
