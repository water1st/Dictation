<UserControl x:Class="Dictation.Presentation.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <Style x:Key="LanguageCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Padding" Value="26" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="46,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="58"
                    Height="58"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="29">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="28"
                           Text="✎"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                <TextBlock FontSize="30"
                           FontWeight="SemiBold"
                           Text="今天想练什么？" />
                <TextBlock Margin="0,5,0,0"
                           FontSize="15"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="先选择语言，之后从这里开始你的学习与复习。" />
            </StackPanel>
            <Border Grid.Column="2"
                    Padding="14,9"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="16">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding CurrentLanguageLabel}" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="学习语言" />
                <TextBlock Margin="0,5,0,16"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="日语和英语的词库、进度与计划彼此独立。" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Command="{Binding SelectJapaneseCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LanguageCardButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJapaneseSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock FontSize="34" Text="🇯🇵" />
                            <TextBlock Margin="0,16,0,0"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       Text="日语" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="假名、汉字与听写练习" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1"
                            Command="{Binding SelectEnglishCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LanguageCardButtonStyle}">
                                <Setter Property="Margin" Value="0,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnglishSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock FontSize="34" Text="🇬🇧" />
                            <TextBlock Margin="0,16,0,0"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       Text="英语" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="词形变化与键盘听写" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Button Command="{Binding OpenLearningCommand}"
                        HorizontalContentAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LanguageCardButtonStyle}">
                            <Setter Property="Margin" Value="0,18,0,0" />
                            <Setter Property="Padding" Value="18,14" />
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="25" Foreground="{DynamicResource AccentBrush}" Text="◎" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="开始学习" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="继续当前语言尚未完成的一轮，或开始新一轮" />
                        </StackPanel>
                        <Border Grid.Column="2" Padding="11,7"
                                Background="{DynamicResource AccentSoftBrush}" CornerRadius="14">
                            <TextBlock x:Name="LearningProgressText"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       Text="{Binding LearningProgressLabel}" />
                        </Border>
                    </Grid>
                </Button>

                <Button x:Name="StartReviewButton" Command="{Binding OpenReviewSessionCommand}" HorizontalContentAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LanguageCardButtonStyle}">
                            <Setter Property="Margin" Value="0,12,0,0" />
                            <Setter Property="Padding" Value="18,14" />
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="25" Foreground="{DynamicResource AccentBrush}" Text="↻" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="开始复习" />
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="继续未完成的一轮，或按记忆安排复习待测和到期词组" />
                        </StackPanel>
                        <Border Grid.Column="2" Margin="12,0,0,0" Padding="12,6" CornerRadius="12"
                                VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock x:Name="ReviewDailyProgress" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Text="{Binding ReviewProgressLabel}" />
                        </Border>
                    </Grid>
                </Button>

                <Button Command="{Binding OpenReviewLibraryCommand}" HorizontalContentAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LanguageCardButtonStyle}">
                            <Setter Property="Margin" Value="0,12,0,0" />
                            <Setter Property="Padding" Value="18,14" />
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="25" Foreground="{DynamicResource AccentBrush}" Text="↻" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="复习词库" />
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="查看待测词组、薄弱词形与下次复习时间" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Command="{Binding OpenWrongAnswersCommand}" HorizontalContentAlignment="Stretch"
                        Style="{StaticResource LanguageCardButtonStyle}" Margin="0,12,0,0" Padding="18,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="25" Foreground="{DynamicResource AccentBrush}" Text="↺" />
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="错题回顾" />
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="看看易错词形，继续学习或针对性重练" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenReviewPlanCommand}" HorizontalContentAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LanguageCardButtonStyle}">
                            <Setter Property="Margin" Value="0,12,0,0" />
                            <Setter Property="Padding" Value="18,14" />
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="25" Foreground="{DynamicResource AccentBrush}" Text="⚙" />
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="复习计划" />
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="设置每日目标、练习形式与整组范围" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <TextBlock x:Name="ReviewProgressError" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource ErrorBrush}" Text="{Binding ReviewProgressErrorMessage}" />

                <Button Command="{Binding OpenLearningPlanCommand}"
                        HorizontalContentAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LanguageCardButtonStyle}">
                            <Setter Property="Margin" Value="0,12,0,0" />
                            <Setter Property="Padding" Value="18,14" />
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="25" Foreground="{DynamicResource AccentBrush}" Text="⚙" />
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="学习计划" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="设置今天的词数、词形和练习方式" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenLexiconLookupCommand}"
                        HorizontalContentAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LanguageCardButtonStyle}">
                            <Setter Property="Margin" Value="0,12,0,0" />
                            <Setter Property="Padding" Value="18,14" />
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="25"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="⌕" />
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="查词" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="打开当前语言的本地词库浏览器" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenImportInboxCommand}"
                        HorizontalContentAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LanguageCardButtonStyle}">
                            <Setter Property="Margin" Value="0,12,0,0" />
                            <Setter Property="Padding" Value="18,14" />
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="25"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="▣" />
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="导入收件箱" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="确认当前语言要学习或复习的词组" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenTextImportCommand}" HorizontalContentAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LanguageCardButtonStyle}">
                            <Setter Property="Margin" Value="0,12,0,0" />
                            <Setter Property="Padding" Value="18,14" />
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="25" Foreground="{DynamicResource AccentBrush}" Text="＋" />
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="批量导入词表" />
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="粘贴词表，选择中文义项后统一进入收件箱" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <TextBlock Margin="0,34,0,5"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="界面主题" />
                <TextBlock Margin="0,0,0,14"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="跟随系统，或选择一个固定主题。" />
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding SelectSystemThemeCommand}"
                            Content="跟随系统">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemThemeSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SelectLightThemeCommand}"
                            Content="浅色">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLightThemeSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SelectDarkThemeCommand}"
                            Content="深色">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkThemeSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <TextBlock Margin="0,22,0,0"
                           Foreground="{DynamicResource ErrorBrush}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Margin="0,24,0,0"
                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                   Text="设置会在选择后立即保存。" />
    </Grid>
</UserControl>
