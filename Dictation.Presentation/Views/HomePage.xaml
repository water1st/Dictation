<UserControl x:Class="Dictation.Presentation.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Dictation.Presentation.Views"
             Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
             FontSize="{DynamicResource BodyFontSize}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/NavigationCards.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationCardButtonStyle}" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="46,32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="今天想练什么？" FontSize="{DynamicResource PageTitleFontSize}" FontWeight="SemiBold" />
            <TextBlock Text="选择一种语言，开始今天的学习与复习。" Margin="0,10,0,30" FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" />
            <Grid Height="220">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Command="{Binding SelectJapaneseCommand}" Style="{StaticResource CardButtonStyle}" Margin="0,0,10,0" AutomationProperties.Name="日语">
                    <StackPanel>
                        <views:LanguageBadge SourceLanguage="Japanese" IsActive="True" HorizontalAlignment="Left" />
                        <TextBlock Text="日语" FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="SemiBold" Margin="0,18,0,8" />
                        <TextBlock Text="假名、汉字与听写练习" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{Binding SelectEnglishCommand}" Style="{StaticResource CardButtonStyle}" Margin="10,0,0,0" AutomationProperties.Name="英语">
                    <StackPanel>
                        <views:LanguageBadge SourceLanguage="English" IsActive="True" HorizontalAlignment="Left" />
                        <TextBlock Text="英语" FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="SemiBold" Margin="0,18,0,8" />
                        <TextBlock Text="词形变化与键盘听写" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="{Binding Home.ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
