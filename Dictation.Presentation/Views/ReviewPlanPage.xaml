<UserControl x:Class="Dictation.Presentation.Views.ReviewPlanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dictation.Presentation.Controls"
             Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
             FontSize="{DynamicResource BodyFontSize}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/Buttons.xaml" />
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/FormControls.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource FormCheckBoxStyle}">
            <Setter Property="Margin" Value="0,0,20,10" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource FormRadioButtonStyle}">
            <Setter Property="Margin" Value="0,0,20,10" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <DataTemplate x:Key="OptionTemplate">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapOptions"><WrapPanel /></ItemsPanelTemplate>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" Padding="14" CornerRadius="16"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource PageContentMargin}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Style="{DynamicResource PageTitleTextStyle}" Text="{Binding WindowTitle}" Margin="0,0,0,14" TextWrapping="Wrap" />
        <WrapPanel Grid.Row="1">
            <Button Content="保存计划" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryActionButtonStyle}"
                    Margin="0,0,8,8" Tag="{StaticResource SaveIconGeometry}" ContentTemplate="{StaticResource IconTextButtonContentTemplate}" />
            <Button Content="重新加载" Command="{Binding RefreshCommand}" Tag="{StaticResource RefreshIconGeometry}" ContentTemplate="{StaticResource IconTextButtonContentTemplate}" />
            <Button Content="取消操作" Command="{Binding CancelCommand}" />
            <Button Content="返回" Command="{Binding BackCommand}" />
        </WrapPanel>
        <ScrollViewer controls:PageScrollHost.IsPageScrollViewer="True" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,10,12,0">
                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,16" />
                <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="每日节奏" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="每天的目标与每轮词数分开；整组不论词形多少只计一个词。"
                                   TextWrapping="Wrap" Margin="0,7,0,16" />
                        <TextBlock Style="{DynamicResource BodyTextStyle}" Text="{Binding DailyReviewTarget, StringFormat=每日复习目标：{0} 组}" />
                        <Slider Style="{StaticResource FormSliderStyle}" Minimum="1" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding DailyReviewTarget, Mode=TwoWay}" Margin="0,8,0,16" />
                        <TextBlock Style="{DynamicResource BodyTextStyle}" Text="{Binding SessionWordLimit, StringFormat=每轮最多：{0} 组}" />
                        <Slider Style="{StaticResource FormSliderStyle}" Minimum="1" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding SessionWordLimit, Mode=TwoWay}" Margin="0,8,0,4" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="练习形式" Margin="0,0,0,14" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="词形（至少一项）" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding FormOptions}" ItemTemplate="{StaticResource OptionTemplate}" ItemsPanel="{StaticResource WrapOptions}" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="题型（至少一项）" Margin="0,8,0,8" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ChannelOptions}" ItemTemplate="{StaticResource OptionTemplate}" ItemsPanel="{StaticResource WrapOptions}" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="书写要求（至少一项；不适用的汉字不会出题）" TextWrapping="Wrap" Margin="0,8,0,8" />
                        <ItemsControl ItemsSource="{Binding OutputOptions}" ItemTemplate="{StaticResource OptionTemplate}" ItemsPanel="{StaticResource WrapOptions}" />
                        <StackPanel Visibility="{Binding IsEnglish, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
                            <TextBlock Style="{DynamicResource FormHeadingTextStyle}" Text="英语词形提示" Margin="0,0,0,10" />
                            <WrapPanel>
                                <RadioButton Content="语法名称" GroupName="EnglishLabels" IsChecked="{Binding IsGrammarName, Mode=TwoWay}" />
                                <RadioButton Content="示例动词范式" GroupName="EnglishLabels" IsChecked="{Binding IsExampleParadigm, Mode=TwoWay}" />
                            </WrapPanel>
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="例如使用 go / went / gone 作为提示，不显示待答单词的答案。" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <TextBox Text="{Binding ExampleQuery, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,10"
                                     Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" />
                            <Button Content="查找示例动词" HorizontalAlignment="Left" Command="{Binding SearchExamplesCommand}"
                                    Tag="{StaticResource SearchIconGeometry}" ContentTemplate="{StaticResource IconTextButtonContentTemplate}" />
                            <ListBox ItemsSource="{Binding ExampleCandidates}" SelectedItem="{Binding SelectedExample, Mode=TwoWay}"
                                     Height="130" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Style="{DynamicResource ListTitleTextStyle}" Text="{Binding Headword}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Meanings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="{Binding Path=.}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="{Binding ExampleSummary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="复习范围与词库" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,8,0,14" Text="固定风险优先；范围取消勾选不会删除词条或记忆。"
                                   TextWrapping="Wrap" />
                        <WrapPanel IsEnabled="{Binding CanEdit}">
                            <RadioButton Content="全部词库（含以后加入的词）" GroupName="ReviewRange" IsChecked="{Binding IsAllWords, Mode=TwoWay}" />
                            <RadioButton Content="指定词组" GroupName="ReviewRange" IsChecked="{Binding IsSelectedRange, Mode=TwoWay}" />
                        </WrapPanel>
                        <CheckBox x:Name="SelectAllGroups" Content="全选当前复习库" IsThreeState="False"
                                  IsChecked="{Binding IsAllSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelectAll, FallbackValue=False}" />
                        <ListBox Height="320" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CanEdit}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding DataContext.CanSelectGroups, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <StackPanel>
                                            <TextBlock Style="{DynamicResource GroupTitleTextStyle}" Text="{Binding Details.HeadwordLabel}" TextWrapping="Wrap" />
                                            <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,6,0,0" Text="{Binding Details.MeaningLabel}" TextWrapping="Wrap" />
                                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,5,0,0" Text="{Binding Details.AttributeLabel}" TextWrapping="Wrap" />
                                            <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,6,0,0" Text="{Binding Details.StateLabel}" Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Text="点击词组查看可用词形；这些词形不会自动全部启用。" TextWrapping="Wrap" Margin="0,12,0,8" />
                        <ItemsControl ItemsSource="{Binding SelectedGroup.Details.Forms}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Style="{DynamicResource BodyTextStyle}" Text="{Binding FormLabel}" TextWrapping="Wrap" Margin="0,4,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="删除当前词组及进度" Command="{Binding DeleteSelectedCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                Style="{StaticResource DestructiveActionButtonStyle}" Tag="{StaticResource DeleteIconGeometry}"
                                ContentTemplate="{StaticResource IconTextButtonContentTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Style="{DynamicResource BodyTextStyle}" Grid.Row="3" Margin="0,12,0,0" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
    </Grid>
</UserControl>
