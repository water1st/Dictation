<UserControl x:Class="Dictation.Presentation.Views.LexiconLookupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dictation.Presentation.Controls"
             xmlns:behaviors="clr-namespace:Dictation.Presentation.Behaviors"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             FontSize="{DynamicResource BodyFontSize}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/Buttons.xaml" />
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/FormControls.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="LookupButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Padding" Value="22,11" />
        </Style>

        <Style x:Key="LookupComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
            <Setter Property="MaxDropDownHeight" Value="340" />
        </Style>

        <DataTemplate x:Key="LookupResultTemplate">
            <Border Margin="0,3"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource ListTitleTextStyle}"
                                   Text="{Binding Headword}" TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,3,0,0"
                                   Text="{Binding Reading}" TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,7,0,0"
                                   Text="{Binding Meanings[0], FallbackValue=暂无中文释义, TargetNullValue=暂无中文释义}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Style="{DynamicResource BodyTextStyle}" Grid.Column="1"
                               Margin="14,0,0,0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding PartOfSpeechLabel}" />
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Margin="0,0,18,0"
                    Command="{Binding BackCommand}"
                    Content="‹  返回"
                    Padding="10,6"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource AccentBrush}" />
            <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="27">
                <TextBlock Style="{DynamicResource PageIconTextStyle}" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="⌕" />
            </Border>
            <StackPanel Grid.Column="2" Margin="16,0,0,0" Style="{DynamicResource HeaderTextGroupStyle}">
                <TextBlock Style="{DynamicResource PageTitleTextStyle}"
                           Text="{Binding WindowTitle}" TextWrapping="Wrap" />
                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,4,0,0"
                           Text="词义词形一处查看" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="3"
                    Padding="13,8"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="15">
                <TextBlock Style="{DynamicResource StrongBodyTextStyle}"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="本地只读词库" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,22"
                Padding="18"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource FormHeadingTextStyle}" Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Text="查询" />
                    <ComboBox Grid.Column="1"
                              HorizontalAlignment="Left"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              IsDropDownOpen="{Binding IsResultDropDownOpen, Mode=TwoWay}"
                              ItemTemplate="{StaticResource LookupResultTemplate}"
                              ItemsSource="{Binding Results}"
                              PreviewKeyDown="SearchComboBoxPreviewKeyDown"
                              SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                              Style="{StaticResource LookupComboBoxStyle}"
                              Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              TextSearch.TextPath="Headword"
                              Width="{Binding ElementName=CandidateResultList, Path=ActualWidth}" />
                    <Button Grid.Column="2"
                            Margin="14,0,0,0"
                            Command="{Binding SearchCommand}"
                            Content="搜索"
                            Tag="{StaticResource SearchIconGeometry}" ContentTemplate="{StaticResource IconTextButtonContentTemplate}"
                            Style="{StaticResource LookupButtonStyle}" />
                </Grid>
                <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,10,0,0"
                           Foreground="{DynamicResource ErrorBrush}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="18"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource SectionTitleTextStyle}"
                               Text="候选结果" />
                    <ListBox Grid.Row="1"
                             x:Name="CandidateResultList"
                             Margin="0,12,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemTemplate="{StaticResource LookupResultTemplate}"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}" ItemContainerStyle="{DynamicResource ContentListItemStyle}" />
                    <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{Binding EmptyStateText}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="22"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <ScrollViewer controls:PageScrollHost.IsPageScrollViewer="True" behaviors:ScrollViewerOffsetBehavior.VerticalOffset="{Binding ScrollOffset, Mode=TwoWay}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource DetailTitleTextStyle}"
                                   Text="{Binding SelectedResult.Headword}" TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,4,0,0"
                                   Text="{Binding SelectedResult.Reading}" TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,14,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding SelectedResult.PartOfSpeechLabel}" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,4,0,0"
                                   Text="{Binding SelectedResult.AttributeLabel}"
                                   TextWrapping="Wrap" />

                        <Button Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding StageSelectedCommand}"
                                Content="加入导入收件箱"
                                IsEnabled="{Binding CanStageSelected}"
                                Style="{StaticResource LookupButtonStyle}" />
                        <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,8,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding ImportStatusMessage}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   Text="{Binding ImportErrorMessage}"
                                   TextWrapping="Wrap" />

                        <TextBlock Style="{DynamicResource SubsectionTitleTextStyle}" Margin="0,24,0,8"
                                   Text="义项" />
                        <ItemsControl ItemsSource="{Binding SelectedResult.Meanings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,3" TextWrapping="Wrap">
                                        <Run Text="•  " />
                                        <Run Text="{Binding Path=., Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,3"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="暂无中文释义"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResult.Meanings.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Style="{DynamicResource SubsectionTitleTextStyle}" Margin="0,24,0,8"
                                   Text="全部词形" />
                        <ItemsControl ItemsSource="{Binding SelectedResult.Forms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{DynamicResource BodyTextStyle}" Text="{Binding Surface}" />
                                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Grid.Column="1"
                                                   Text="{Binding Reading}" TextWrapping="Wrap" />
                                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Grid.Column="2"
                                                   Text="{Binding FormLabel}" TextWrapping="Wrap" />
                                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Grid.Column="3"
                                                   Text="{Binding DetailLabel}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
