<UserControl x:Class="Dictation.Presentation.Views.LexiconLookupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Dictation.Presentation.Behaviors"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <Style x:Key="LookupButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="22,11" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LookupComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ThemedEditableComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PART_EditableTextBox"
                                 Grid.Column="0"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Padding="{TemplateBinding Padding}"
                                 VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <ToggleButton x:Name="PART_DropDownToggle"
                                      Grid.Column="1"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsDropDownOpen, Mode=TwoWay}">
                            <Path Data="M 0 0 L 8 0 L 4 5 Z"
                                  Fill="{DynamicResource AccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </ToggleButton>
                    </Grid>
                </Border>
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Bottom"
                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualWidth}"
                            MaxHeight="340"
                            Padding="6"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="LookupComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource LookupComboBoxItemStyle}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template" Value="{StaticResource ThemedEditableComboBoxTemplate}" />
        </Style>

        <DataTemplate x:Key="LookupResultTemplate">
            <Border Margin="0,3"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{Binding Headword}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="{Binding Reading}" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="{Binding Meanings[0], FallbackValue=暂无中文释义, TargetNullValue=暂无中文释义}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="14,0,0,0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding PartOfSpeechLabel}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="38,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Margin="0,0,18,0"
                    Command="{Binding BackCommand}"
                    Content="‹  返回"
                    Padding="10,6"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource AccentBrush}" />
            <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="27">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="27"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="⌕" />
            </Border>
            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                <TextBlock FontSize="29"
                           FontWeight="SemiBold"
                           Text="{Binding WindowTitle}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="输入词形，查看词库中的义项、属性与全部词形。" />
            </StackPanel>
            <Border Grid.Column="3"
                    Padding="13,8"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="15">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="本地只读词库" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,22"
                Padding="18"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="查询" />
                    <ComboBox Grid.Column="1"
                              HorizontalAlignment="Left"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              IsDropDownOpen="{Binding IsResultDropDownOpen, Mode=TwoWay}"
                              ItemTemplate="{StaticResource LookupResultTemplate}"
                              ItemsSource="{Binding Results}"
                              PreviewKeyDown="SearchComboBoxPreviewKeyDown"
                              SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                              Style="{StaticResource LookupComboBoxStyle}"
                              Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              TextSearch.TextPath="Headword"
                              Width="{Binding ElementName=CandidateResultList, Path=ActualWidth}" />
                    <Button Grid.Column="2"
                            Margin="14,0,0,0"
                            Command="{Binding SearchCommand}"
                            Content="搜索"
                            Style="{StaticResource LookupButtonStyle}" />
                </Grid>
                <TextBlock Margin="0,10,0,0"
                           Foreground="{DynamicResource ErrorBrush}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="18"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="候选结果" />
                    <ListBox Grid.Row="1"
                             x:Name="CandidateResultList"
                             Margin="0,12,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemTemplate="{StaticResource LookupResultTemplate}"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="{Binding EmptyStateText}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="22"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <ScrollViewer behaviors:ScrollViewerOffsetBehavior.VerticalOffset="{Binding ScrollOffset, Mode=TwoWay}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedResult.Headword}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="{Binding SelectedResult.Reading}" />
                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding SelectedResult.PartOfSpeechLabel}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="{Binding SelectedResult.AttributeLabel}"
                                   TextWrapping="Wrap" />

                        <Button Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding StageSelectedCommand}"
                                Content="加入导入收件箱"
                                IsEnabled="{Binding CanStageSelected}"
                                Style="{StaticResource LookupButtonStyle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding ImportStatusMessage}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   Text="{Binding ImportErrorMessage}"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,24,0,8"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="义项" />
                        <ItemsControl ItemsSource="{Binding SelectedResult.Meanings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,3" TextWrapping="Wrap">
                                        <Run Text="•  " />
                                        <Run Text="{Binding Path=., Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,3"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="暂无中文释义"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResult.Meanings.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Margin="0,24,0,8"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="全部词形" />
                        <ItemsControl ItemsSource="{Binding SelectedResult.Forms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Surface}" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Text="{Binding Reading}" />
                                        <TextBlock Grid.Column="2"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Text="{Binding FormLabel}" />
                                        <TextBlock Grid.Column="3"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Text="{Binding DetailLabel}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
