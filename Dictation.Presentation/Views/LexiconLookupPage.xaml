<UserControl x:Class="Dictation.Presentation.Views.LexiconLookupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dictation.Presentation.Controls"
             xmlns:behaviors="clr-namespace:Dictation.Presentation.Behaviors"
             SizeChanged="LookupPageSizeChanged"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             FontSize="{DynamicResource BodyFontSize}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/Buttons.xaml" />
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/FormControls.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="LookupButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Padding" Value="22,11" />
        </Style>

        <Style x:Key="LookupComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FormComboBoxStyle}">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
            <Setter Property="MaxDropDownHeight" Value="340" />
        </Style>

        <DataTemplate x:Key="LookupResultTemplate">
            <Border Margin="0,3"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource ListTitleTextStyle}"
                                   Text="{Binding Headword}" TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,3,0,0"
                                   Text="{Binding Reading}" TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,7,0,0"
                                   Text="{Binding Meanings[0], FallbackValue=暂无中文释义, TargetNullValue=暂无中文释义}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Style="{DynamicResource BodyTextStyle}" Grid.Column="1"
                               Margin="14,0,0,0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding PartOfSpeechLabel}" />
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="54"
                    Height="54"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="27">
                <TextBlock Style="{DynamicResource PageIconTextStyle}" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="⌕" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Style="{DynamicResource HeaderTextGroupStyle}">
                <TextBlock Style="{DynamicResource PageTitleTextStyle}"
                           Text="{Binding WindowTitle}" TextWrapping="Wrap" />
                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,4,0,0"
                           Text="词义词形一处查看" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="2"
                    Padding="13,8"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="15">
                <TextBlock Style="{DynamicResource StrongBodyTextStyle}"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="本地只读词库" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,22"
                Padding="18"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource FormHeadingTextStyle}" Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Text="查询" />
                    <controls:LexiconQueryComboBox x:Name="QueryComboBox" Grid.Column="1"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              IsDropDownOpen="{Binding IsResultDropDownOpen, Mode=TwoWay}"
                              ItemTemplate="{StaticResource LookupResultTemplate}"
                              ItemsSource="{Binding Results}"
                              PreviewKeyDown="SearchComboBoxPreviewKeyDown"
                              DropDownOpened="SearchComboBoxDropDownOpened"
                              SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                              Style="{StaticResource LookupComboBoxStyle}"
                              Height="{Binding ElementName=SearchButton, Path=ActualHeight}"
                              Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=Explicit}" />
                    <Button x:Name="SearchButton" Grid.Column="2"
                            Margin="14,0,0,0"
                            Command="{Binding SearchCommand}"
                            Content="搜索"
                            Tag="{StaticResource SearchIconGeometry}"
                            Style="{StaticResource LookupButtonStyle}" />
                </Grid>
                <Border Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{DynamicResource BodyTextStyle}"
                               Foreground="{DynamicResource ErrorBrush}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CandidatePane" Grid.Column="0"
                    Padding="18"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource SectionTitleTextStyle}"
                               Text="候选结果" />
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox
                                 Margin="0,12,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemTemplate="{StaticResource LookupResultTemplate}"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}" ItemContainerStyle="{DynamicResource ContentListItemStyle}" />
                    </Grid>
                    <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{Binding EmptyStateText}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="22"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedResult}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="请选择候选词条查看详情。" TextWrapping="Wrap" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedResult}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ScrollViewer controls:PageScrollHost.IsPageScrollViewer="True"
                                      behaviors:ScrollViewerOffsetBehavior.IsAttached="True"
                                      behaviors:ScrollViewerOffsetBehavior.VerticalOffset="{Binding ScrollOffset, Mode=TwoWay}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource DetailTitleTextStyle}"
                                           Text="{Binding SelectedResult.Headword}" TextWrapping="Wrap" />
                                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,4,0,0"
                                           Text="{Binding SelectedResult.Reading}" TextWrapping="Wrap" />
                                <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,14,0,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding SelectedResult.PartOfSpeechLabel}" />
                                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,4,0,0"
                                           Text="{Binding SelectedResult.AttributeLabel}"
                                           TextWrapping="Wrap" />

                                <Button Tag="{StaticResource InboxIconGeometry}" Margin="0,18,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding StageSelectedCommand}"
                                        Content="加入导入收件箱"
                                        IsEnabled="{Binding CanStageSelected}"
                                        Style="{StaticResource LookupButtonStyle}" />
                                <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,8,0,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding ImportStatusMessage}"
                                           TextWrapping="Wrap" />
                                <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           Text="{Binding ImportErrorMessage}"
                                           TextWrapping="Wrap" />

                                <TextBlock Style="{DynamicResource SubsectionTitleTextStyle}" Margin="0,24,0,8"
                                           Text="义项" />
                                <ItemsControl ItemsSource="{Binding SelectedResult.Meanings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,3" TextWrapping="Wrap">
                                                <Run Text="•  " />
                                                <Run Text="{Binding Path=., Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,3"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Text="暂无中文释义"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedResult.Meanings.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Style="{DynamicResource SubsectionTitleTextStyle}" Margin="0,24,0,8"
                                           Text="全部词形" />
                                <ItemsControl ItemsSource="{Binding SelectedResult.Forms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.15*" />
                                                    <ColumnDefinition Width="1.15*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{DynamicResource BodyTextStyle}" Text="{Binding Surface}" TextWrapping="Wrap" />
                                                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Grid.Column="1"
                                                           Text="{Binding Reading}" TextWrapping="Wrap" />
                                                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Grid.Column="2"
                                                           Text="{Binding FormLabel}" TextWrapping="Wrap" />
                                                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Grid.Column="3"
                                                           Text="{Binding DetailLabel}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
