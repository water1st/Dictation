<UserControl x:Class="Dictation.Presentation.Views.PracticeSessionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             FontSize="{DynamicResource BodyFontSize}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/Buttons.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Padding" Value="16,9" />
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconActionButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="42,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="{DynamicResource PageTitleFontSize}" FontWeight="SemiBold" Text="{Binding WindowTitle}" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="{Binding ProgressLabel}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding OpenBrowseCommand}"
                    Content="浏览本轮"
                    Style="{StaticResource ActionButtonStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="0,24,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Border x:Name="EmptyPanel" Padding="28" CornerRadius="20"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Visibility="{Binding IsEmptyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource EmphasisFontSize}" FontWeight="SemiBold" Text="暂时没有复习任务" />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding EmptyMessage}" />
                        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="可返回首页，调整复习计划或导入待测词组。" />
                    </StackPanel>
                </Border>
                <Border x:Name="QuestionPanel"
                        Padding="28"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Visibility="{Binding IsQuestionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Text="中文释义" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="{DynamicResource EmphasisFontSize}"
                                           FontWeight="SemiBold"
                                           Text="{Binding MeaningText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="ReplayQuestionButton"
                                    Grid.Column="1"
                                    Margin="18,0,0,0"
                                    Command="{Binding ReplayQuestionCommand}"
                                    AutomationProperties.Name="播放题目发音"
                                    Style="{StaticResource IconButtonStyle}"
                                    Visibility="{Binding IsQuestionReplayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="🔊" />
                            </Button>
                        </Grid>
                        <WrapPanel Margin="0,18,0,0">
                            <TextBlock FontWeight="SemiBold" Text="词形：" />
                            <TextBlock Margin="0,0,18,0" Text="{Binding Question.FormLabel}" />
                            <TextBlock FontWeight="SemiBold" Text="输出：" />
                            <TextBlock Text="{Binding Question.OutputLabel}" />
                        </WrapPanel>
                        <TextBox x:Name="AnswerTextBox"
                                 Margin="0,18,0,0"
                                 MinHeight="46"
                                 Padding="12,9"
                                 FontSize="{DynamicResource EmphasisFontSize}"
                                 SpellCheck.IsEnabled="False"
                                 Text="{Binding AnswerText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                            <Button Command="{Binding SubmitCommand}"
                                    Content="提交答案"
                                    Style="{StaticResource ActionButtonStyle}" />
                        </StackPanel>
                        <Border x:Name="FeedbackPanel"
                                Margin="0,20,0,0"
                                Padding="16"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="14"
                                Visibility="{Binding IsFeedbackVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="SemiBold" Text="{Binding FeedbackLabel}" />
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <TextBlock Text="正确答案：" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Feedback.CorrectAnswer}" />
                                </StackPanel>
                                <Button Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ContinueCommand}"
                                        Content="继续"
                                        Style="{StaticResource ActionButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="BrowsePanel"
                        Padding="22"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Visibility="{Binding IsBrowsing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="SemiBold" Text="浏览本轮" />
                            <Button Grid.Column="1" Command="{Binding CloseBrowseCommand}" Content="返回题目" />
                        </Grid>
                        <ListBox Grid.Row="1"
                                 Margin="0,16,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding BrowseMembers}"
                                 SelectedItem="{Binding SelectedBrowseMember}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="14"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel>
                                            <TextBlock FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="SemiBold" Text="{Binding Headword}" />
                                            <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Meanings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <WrapPanel Margin="0,7,0,0">
                                                <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}" Text="{Binding PartOfSpeechLabel}" />
                                                <TextBlock Margin="12,0,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           Text="{Binding AttributeLabel}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding BrowseForms}"
                                      SelectedItem="{Binding SelectedBrowseForm}"
                                      DisplayMemberPath="Surface" />
                            <Button x:Name="ReplayBrowseButton"
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Command="{Binding ReplayBrowseCommand}"
                                    AutomationProperties.Name="播放所选词形"
                                    Style="{StaticResource IconButtonStyle}">
                                <TextBlock Text="🔊" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="SummaryPanel"
                        Padding="28"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Visibility="{Binding IsSummaryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource EmphasisFontSize}" FontWeight="SemiBold" Text="本轮完成" />
                        <TextBlock x:Name="CompletedGroupCount" Margin="0,9,0,0"
                                   Text="{Binding Summary.CompletedWordGroupCount, StringFormat=完成 {0} 个词组}" />
                        <TextBlock Margin="0,9,0,0" Text="{Binding Summary.AnsweredCount, StringFormat=共完成 {0} 次作答}" />
                        <TextBlock Margin="0,18,0,7" FontWeight="SemiBold" Text="本轮曾错" />
                        <ItemsControl ItemsSource="{Binding Summary.Errors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,3,0,0" Text="{Binding CorrectAnswer}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Button x:Name="CancelPracticeOperationButton" HorizontalAlignment="Left"
                    Command="{Binding CancelCommand}" Content="取消当前操作"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Foreground="{DynamicResource ErrorBrush}"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
            <Button x:Name="RetryStartButton"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding RetryStartCommand}"
                    Content="重试加载"
                    Style="{StaticResource ActionButtonStyle}"
                    Visibility="{Binding IsRetryStartVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>
