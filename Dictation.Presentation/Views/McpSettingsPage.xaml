<UserControl x:Class="Dictation.Presentation.Views.McpSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource ForegroundBrush}"
             FontSize="{DynamicResource BodyFontSize}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/Buttons.xaml" />
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/FormControls.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource FormCheckBoxStyle}"></Style>
        </ResourceDictionary>
    </UserControl.Resources>
        <StackPanel MaxWidth="880">
            <TextBlock Style="{DynamicResource HeroTitleTextStyle}" Text="AI 导入设置" />
            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,8,0,24" TextWrapping="Wrap"
                       Text="让Agent帮你查词和准备导入。导入只进入收件箱，学习或复习仍由你确认。" />
            <Border x:Name="SettingsCard" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="22" Padding="24">
                <StackPanel>
                    <CheckBox x:Name="McpEnabled" Content="开启本机 MCP 服务（默认关闭）" IsChecked="{Binding Enabled}" />
                    <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,20,0,6" Text="监听端口 · 1024–65535" />
                    <TextBox x:Name="PortInput" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left"
                             Padding="10,6" SpellCheck.IsEnabled="False" Foreground="{DynamicResource ForegroundBrush}" Background="{DynamicResource WindowBackgroundBrush}" />
                    <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,16,0,6" Text="本机地址 · 可选中复制" />
                    <TextBox x:Name="EndpointOutput" IsReadOnly="True" Text="{Binding EndpointText, Mode=OneWay}" Padding="10,6"
                             Foreground="{DynamicResource ForegroundBrush}" Background="{DynamicResource WindowBackgroundBrush}" />
                    <TextBlock Style="{DynamicResource BodyTextStyle}" x:Name="RuntimeStatus" Margin="0,12,0,0" Text="{Binding RuntimeStatusLabel}" Foreground="{DynamicResource AccentBrush}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="SaveButton" Content="保存并应用" Command="{Binding SaveCommand}" Padding="18,10" Margin="0,0,12,0" />
                        <Button x:Name="RetryButton" Content="重试已保存设置" Command="{Binding RetryCommand}" Padding="18,10" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Margin="0,20,0,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="22" Padding="24">
                <StackPanel>
                    <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="连接 Codex" />
                    <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="仅点击按钮才会修改客户端配置；注册或注销后请重载客户端配置。修改端口不会自动覆盖旧注册。" />
                    <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,8,0,0" Text="{Binding ConfigPath}" TextWrapping="Wrap" />
                    <TextBlock Style="{DynamicResource BodyTextStyle}" x:Name="RegistrationStatus" Margin="0,12,0,0" Text="{Binding RegistrationMessage}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="RegisterButton" Content="注册当前端点" Command="{Binding RegisterCommand}" Padding="18,10" Margin="0,0,12,0" />
                        <Button x:Name="UnregisterButton" Content="注销本应用端点" Command="{Binding UnregisterCommand}" Padding="18,10" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,16,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <TextBlock Style="{DynamicResource BodyTextStyle}" x:Name="ErrorOutput" Margin="0,8,0,0" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
        </StackPanel>
</UserControl>
