<UserControl x:Class="Dictation.Presentation.Views.ReviewLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="16" CornerRadius="18"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="刷新" Command="{Binding RefreshCommand}" />
                <Button Content="取消读取" Command="{Binding CancelCommand}" />
                <Button Content="返回" Command="{Binding BackCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding WindowTitle}" />
                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="先补薄弱词形，再巩固整组记忆。" />
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" Margin="0,0,0,18" Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     Foreground="{DynamicResource ForegroundBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding StateLabel}" />
                                <TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding HeadwordLabel}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Margin="0,8,0,0" Text="{Binding MeaningLabel}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding AttributeLabel}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0" Text="{Binding NextReviewLabel, StringFormat=下次：{0}}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding RetentionLabel, StringFormat=预计保持率：{0}}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Padding="20" CornerRadius="20"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="词形记忆" />
                        <TextBlock Margin="0,8,0,14" Text="点击左侧词组查看各词形；查看本身不会改变进度。"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" />
                        <StackPanel DataContext="{Binding SelectedGroup}">
                            <TextBlock FontSize="23" FontWeight="SemiBold" Text="{Binding HeadwordLabel}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding MeaningLabel}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,16" Text="{Binding AttributeLabel}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Forms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" Padding="14" CornerRadius="16"
                                                Background="{DynamicResource WindowBackgroundBrush}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding FormLabel}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,6,0,0" Text="{Binding StateLabel}" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Margin="0,6,0,0" Text="{Binding DueLabel, StringFormat=下次：{0}}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding RetentionLabel, StringFormat=预计保持率：{0}}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding CountsLabel}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Margin="0,14,0,0" Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
