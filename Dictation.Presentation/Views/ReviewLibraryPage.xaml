<UserControl x:Class="Dictation.Presentation.Views.ReviewLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dictation.Presentation.Controls"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource ForegroundBrush}"
             FontSize="{DynamicResource BodyFontSize}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/Buttons.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="16" CornerRadius="18"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="刷新" Command="{Binding RefreshCommand}" />
                <Button Content="取消读取" Command="{Binding CancelCommand}" />
                <Button Content="返回" Command="{Binding BackCommand}" />
            </StackPanel>
            <StackPanel Style="{DynamicResource HeaderTextGroupStyle}">
                <TextBlock Style="{DynamicResource PageTitleTextStyle}" Text="{Binding WindowTitle}" TextWrapping="Wrap" />
                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="{DynamicResource DescriptionTopMargin}"
                           Text="查看词组记忆进度" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Grid.Row="1" Margin="0,0,0,18" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     Foreground="{DynamicResource ForegroundBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Style="{DynamicResource BodyTextStyle}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding StateLabel}" />
                                <TextBlock Style="{DynamicResource GroupHeadwordTextStyle}" Text="{Binding HeadwordLabel}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,8,0,0" Text="{Binding MeaningLabel}" TextWrapping="Wrap" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,5,0,0" Text="{Binding AttributeLabel}" TextWrapping="Wrap" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,12,0,0" Text="{Binding NextReviewLabel, StringFormat=下次：{0}}" TextWrapping="Wrap" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,4,0,0" Text="{Binding RetentionLabel, StringFormat=预计保持率：{0}}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Padding="{DynamicResource ContentCardPadding}" CornerRadius="20"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <ScrollViewer controls:PageScrollHost.IsPageScrollViewer="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="词形记忆" />
                        <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,8,0,14" Text="点击左侧词组查看各词形；查看本身不会改变进度。" TextWrapping="Wrap" />
                        <StackPanel DataContext="{Binding SelectedGroup}">
                            <TextBlock Style="{DynamicResource DetailTitleTextStyle}" Text="{Binding HeadwordLabel}" TextWrapping="Wrap" />
                            <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,8,0,0" Text="{Binding MeaningLabel}" TextWrapping="Wrap" />
                            <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,6,0,16" Text="{Binding AttributeLabel}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Forms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" Padding="14" CornerRadius="16"
                                                Background="{DynamicResource WindowBackgroundBrush}">
                                            <StackPanel>
                                                <TextBlock Style="{DynamicResource StrongBodyTextStyle}" Text="{Binding FormLabel}" TextWrapping="Wrap" />
                                                <TextBlock Style="{DynamicResource BodyTextStyle}" Margin="0,6,0,0" Text="{Binding StateLabel}" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="{DynamicResource DescriptionTopMargin}" Text="{Binding DueLabel, StringFormat=下次：{0}}" TextWrapping="Wrap" />
                                                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,4,0,0" Text="{Binding RetentionLabel, StringFormat=预计保持率：{0}}" TextWrapping="Wrap" />
                                                <TextBlock Style="{DynamicResource SecondaryBodyTextStyle}" Margin="0,4,0,0" Text="{Binding CountsLabel}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Style="{DynamicResource BodyTextStyle}" Grid.Row="3" Margin="0,14,0,0" Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
