<UserControl x:Class="Dictation.Presentation.Views.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Dictation.Presentation.Views"
             xmlns:configuration="clr-namespace:Dictation.Core.Configuration;assembly=Dictation.Core"
             Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" /><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="14,9" /><Setter Property="Margin" Value="4,0" /></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24" MaxWidth="900">
            <TextBlock Text="{Binding WindowTitle}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="每一天的小进步，都值得留下。" Margin="0,8,0,24" Foreground="{DynamicResource SecondaryForegroundBrush}" />
            <Border Padding="20" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="‹" Command="{Binding PreviousMonthCommand}" ToolTip="上个月" />
                            <Button Content="本月" Command="{Binding CurrentMonthCommand}" />
                            <Button Content="›" Command="{Binding NextMonthCommand}" ToolTip="下个月" />
                        </StackPanel>
                        <TextBlock x:Name="CalendarMonthLabel" Text="{Binding MonthLabel}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <UniformGrid Columns="7" Margin="0,0,0,8">
                        <TextBlock Text="一" HorizontalAlignment="Center" /><TextBlock Text="二" HorizontalAlignment="Center" /><TextBlock Text="三" HorizontalAlignment="Center" /><TextBlock Text="四" HorizontalAlignment="Center" /><TextBlock Text="五" HorizontalAlignment="Center" /><TextBlock Text="六" HorizontalAlignment="Center" /><TextBlock Text="日" HorizontalAlignment="Center" />
                    </UniformGrid>
                    <ItemsControl x:Name="MonthGrid" ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3" Padding="9,7" MinHeight="84" CornerRadius="16" Background="{DynamicResource WindowBackgroundBrush}" ToolTip="{Binding Details}">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding HasDate}" Value="False"><Setter Property="Opacity" Value="0" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DayLabel}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0" HorizontalAlignment="Center">
                                            <views:LanguageBadge SourceLanguage="{x:Static configuration:LearningLanguage.Japanese}" IsActive="{Binding JapaneseIsCheckedIn}" Margin="0,0,6,0" />
                                            <views:LanguageBadge SourceLanguage="{x:Static configuration:LearningLanguage.English}" IsActive="{Binding EnglishIsCheckedIn}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="日语与英语分别完成当天任务，分别点亮自己的徽章。" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                    <TextBlock Text="{Binding CalendarErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button Content="刷新记录" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
