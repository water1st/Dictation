<UserControl x:Class="Dictation.Presentation.Views.WrongAnswerListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:learning="clr-namespace:Dictation.Core.Learning;assembly=Dictation.Core"
             Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
             FontSize="{DynamicResource BodyFontSize}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dictation.Presentation;component/Theme/Buttons.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="18"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="{DynamicResource PageTitleFontSize}" FontWeight="SemiBold" Text="{Binding WindowTitle}" />
            <TextBlock Margin="0,8,0,0" Text="历史错误不会因重试答对而消失；自动复习仍按记忆安排。" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" />
            <WrapPanel Margin="0,16,0,0">
                <Button x:Name="RepracticeButton" Content="重练选中复习错题" Command="{Binding RepracticeCommand}" />
                <Button Content="继续原学习" Command="{Binding ContinueLearningCommand}" />
                <Button Content="刷新" Command="{Binding RefreshCommand}" />
                <Button Content="取消" Command="{Binding CancelCommand}" />
            </WrapPanel>
            <TextBlock Margin="0,10,0,0" Text="有未完成复习时会先恢复原轮次，不丢弃进度。"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DockPanel>
                <CheckBox x:Name="SelectAllBox" DockPanel.Dock="Top" Content="全选" IsThreeState="True"
                          IsChecked="{Binding SelectAll,Mode=TwoWay}" Margin="4,0,0,12" />
                <ListBox x:Name="WrongAnswerList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem,Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate>
                        <DockPanel>
                            <CheckBox IsChecked="{Binding IsSelected,Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="SemiBold" Text="{Binding Heading}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding Item.Meanings}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding HistoryLabel}" Foreground="{DynamicResource ErrorBrush}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding PlacementLabel}" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding NextReviewLabel}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Border x:Name="DetailPanel" Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="18" Padding="20">
                <Border.Style><Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontSize="{DynamicResource EmphasisFontSize}" FontWeight="SemiBold" Text="{Binding SelectedItem.Heading}" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailMeanings" Margin="0,10,0,0" Text="{Binding SelectedItem.Item.Meanings}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <Button x:Name="DetailSpeakerButton" Content="🔊" ToolTip="播放对应词形" AutomationProperties.Name="播放对应词形"
                                FontSize="{DynamicResource IconFontSize}"
                                HorizontalAlignment="Left" Margin="0,12,0,12" Command="{Binding PlayDetailCommand}" />
                        <TextBlock Text="原始错误记录" FontWeight="SemiBold" Margin="0,0,0,12" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedItem.Item.Attempts}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AnsweredAtUtc,StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock Margin="0,0,8,0"><TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="看义默写" /><Style.Triggers>
                                                    <DataTrigger Binding="{Binding Channel}" Value="{x:Static learning:LearningChannel.Dictation}"><Setter Property="Text" Value="听写" /></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            <TextBlock><TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="英文" /><Style.Triggers>
                                                    <DataTrigger Binding="{Binding OutputMode}" Value="{x:Static learning:LearningOutputMode.Kana}"><Setter Property="Text" Value="假名" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding OutputMode}" Value="{x:Static learning:LearningOutputMode.Kanji}"><Setter Property="Text" Value="汉字" /></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </WrapPanel>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="当时作答：" /><Run Text="{Binding SubmittedText}" /></TextBlock>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="正确答案：" /><Run Text="{Binding ExpectedAnswer}" /></TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
