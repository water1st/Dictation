<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>Dictation.TtsHost.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与同目录WPF共用Extensions运行库，避免共享框架消除本地副本后子进程找不到DI。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="DotNetG2P" Version="1.8.0" />
    <PackageReference Include="DotNetG2P.MeCab" Version="1.8.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
    <PackageReference Include="PiperPlus.Core" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dictation.Core\Dictation.Core.csproj" />
  </ItemGroup>

</Project>
